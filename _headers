# Keep the HTML shell and app bootstrap revalidated so returning visitors see new deployments.
/
  Cache-Control: no-cache, no-store, must-revalidate
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
/main.js
  Cache-Control: no-cache, must-revalidate, max-age=0

# Menu, delivery, promotion, and content JSON should never be reused stale.
/assets/data/*
  Cache-Control: no-cache, no-store, must-revalidate

# Image assets can be cached by the browser/CDN; replace filenames when changing an image.
/assets/images/*
  Cache-Control: public, max-age=604800
